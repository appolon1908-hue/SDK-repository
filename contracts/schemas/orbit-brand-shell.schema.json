{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.codestra.co/schemas/orbit-brand-shell.v2.json",
  "title": "Codestra Orbit Brand Shell Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand",
    "resource_version",
    "publication_status",
    "logo_asset_id",
    "navigation",
    "application_links",
    "contact",
    "announcement"
  ],
  "properties": {
    "brand": {
      "type": "string",
      "enum": [
        "codestra",
        "breero",
        "beyvra",
        "moneybee",
        "larim",
        "transportation",
        "telnexa",
        "klyrow",
        "social",
        "restaurant",
        "neutral"
      ]
    },
    "resource_version": { "type": "integer", "minimum": 0 },
    "publication_status": {
      "type": "string",
      "enum": ["draft", "published", "withdrawn"]
    },
    "logo_asset_id": { "$ref": "#/$defs/assetId" },
    "navigation": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "application_links": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telephone_content_key", "email_content_key"],
      "properties": {
        "telephone_content_key": { "$ref": "#/$defs/contentKey" },
        "email_content_key": { "$ref": "#/$defs/contentKey" }
      }
    },
    "announcement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["content_key", "severity", "dismissible"],
      "properties": {
        "content_key": { "$ref": "#/$defs/contentKey" },
        "severity": {
          "type": "string",
          "enum": ["information", "success", "warning", "error"]
        },
        "dismissible": { "type": "boolean" },
        "starts_at": { "type": ["string", "null"], "format": "date-time" },
        "ends_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "publication_id": {
      "type": ["string", "null"],
      "pattern": "^pub_[A-Za-z0-9_-]{8,128}$"
    }
  },
  "$defs": {
    "contentKey": {
      "type": "string",
      "minLength": 5,
      "maxLength": 180,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){2,}$"
    },
    "assetId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 132,
      "pattern": "^ast_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_key", "href", "order", "requires_authentication"],
      "properties": {
        "content_key": { "$ref": "#/$defs/contentKey" },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^(?:/|https://[^@\\s]+)$"
        },
        "order": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "requires_authentication": { "type": "boolean" },
        "required_capability": { "type": ["string", "null"], "maxLength": 160 }
      }
    }
  }
}
