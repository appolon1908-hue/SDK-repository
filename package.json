    "ci": "pnpm contracts:validate && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
