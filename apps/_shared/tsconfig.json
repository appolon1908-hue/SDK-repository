{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@codestra/contracts": ["../../packages/contracts/dist/index.d.ts"],
      "@codestra/connector-kit": ["../../packages/connector-kit/dist/index.d.ts"],
      "@codestra/social-sdk": ["../../packages/social-sdk/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
