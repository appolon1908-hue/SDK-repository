{
  "name": "@codestra/intake-ui",
  "version": "0.1.0",
  "description": "Framework-neutral accessible UI controllers, render models, and the Codestra Orbit corporate shell contract.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./styles/**/*.css"],
  "files": ["dist", "styles", "README.md", "ORBIT.md", "HORIZON.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./orbit": { "types": "./dist/orbit.d.ts", "default": "./dist/orbit.js" },
    "./orbit/styles": "./styles/orbit/index.css",
    "./orbit/tokens.css": "./styles/orbit/tokens.css",
    "./orbit/themes.css": "./styles/orbit/themes.css",
    "./orbit/base.css": "./styles/orbit/base.css",
    "./orbit/components.css": "./styles/orbit/components.css",
    "./orbit/auth.css": "./styles/orbit/auth.css",
    "./orbit/footer.css": "./styles/orbit/footer.css",
    "./horizon": { "types": "./dist/horizon.d.ts", "default": "./dist/horizon.js" },
    "./horizon/styles": "./styles/horizon/index.css",
    "./horizon/tokens.css": "./styles/horizon/tokens.css",
    "./horizon/themes.css": "./styles/horizon/themes.css",
    "./horizon/base.css": "./styles/horizon/base.css",
    "./horizon/components.css": "./styles/horizon/components.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
