# The image must be pinned by digest, for example:
# ghcr.io/appolon1908-hue/codestra-camel-protocol-gateway@sha256:...
CODESTRA_CAMEL_GATEWAY_IMAGE=

# Keep false until an approved protocol-specific release is installed.
CODESTRA_CAMEL_ENABLED=false

# Empty means deny all. Values are lowercase CSV tokens.
CODESTRA_ALLOWED_PROTOCOLS=
# Operations are protocol-scoped, for example: smpp:submit,amqp:publish
CODESTRA_ALLOWED_OPERATIONS=

CODESTRA_PRIVATE_NETWORK=codestra-private
