# Copy to .env for local development. Never commit real values.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://codestra:codestra@localhost:5433/codestra_middleware

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Per-IP defense-in-depth rate limit (Kong, or whatever sits in front of
# this service, is expected to carry the primary, tenant-aware limit).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For (e.g.
# Kong's real address). Leave unset until a real proxy is deployed in front
# of this service -- otherwise request.ip (used by the rate limiter above,
# and by request logging) is taken from a client-supplied header that any
# direct caller can spoof.
TRUSTED_PROXY_CIDRS=

# --- OIDC / JWT verification ----------------------------------------------
# There is no real identity provider deployed with this repository. These
# variables are the seam where a real OIDC provider (e.g. Keycloak) plugs
# in: point OIDC_JWKS_URL at that provider's JWKS endpoint and set the
# issuer/audience it issues tokens with. Until that is done, every request
# is rejected — Middleware never accepts unverified tokens.
OIDC_ISSUER=https://auth.codestra.co/realms/codestra
OIDC_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs
OIDC_AUDIENCE=codestra-middleware
# Claim in the verified JWT that carries the tenant ID. Every DB query is
# scoped to this claim's value; it is never read from a request body or URL.
OIDC_TENANT_CLAIM=tenant_id
# Same verification path is used for the enterprise (service-to-service)
# API in this implementation; point this at the service-token issuer if it
# differs from the end-user OIDC provider.
JWT_CLOCK_TOLERANCE_SECONDS=30

# --- Webhook subscriptions -------------------------------------------------
# Hours the previous signing secret keeps validating deliveries after a
# rotate-secret call, per the documented overlap window.
WEBHOOK_SECRET_OVERLAP_HOURS=24
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Test/local-development escape hatch ONLY (see src/webhooks/ssrf.ts). Never
# set this to true outside test configuration; every real deployment must
# leave it unset.
WEBHOOK_SSRF_ALLOW_INSECURE_FOR_TESTS=false

# --- Restricted gateway outbound client -----------------------------------
# Base URL of the product-local restricted gateway this Middleware instance
# dispatches connector commands to (contracts/openapi/codestra-restricted-gateway.openapi.yaml).
# No such gateway ships in this repository; point this at a real deployment.
RESTRICTED_GATEWAY_BASE_URL=https://product-gateway.invalid
RESTRICTED_GATEWAY_SERVICE_TOKEN=REPLACE_AT_DEPLOYMENT
RESTRICTED_GATEWAY_WORKLOAD_ID=codestra-middleware
RESTRICTED_GATEWAY_TIMEOUT_MS=15000
