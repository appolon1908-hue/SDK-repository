# All images must be immutable digest references before the optional profile is activated.
SVIX_SERVER_IMAGE=svix/svix-server@sha256:REPLACE_WITH_VERIFIED_DIGEST
SVIX_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_VERIFIED_DIGEST
SVIX_PGBOUNCER_IMAGE=edoburu/pgbouncer@sha256:REPLACE_WITH_VERIFIED_DIGEST
SVIX_REDIS_IMAGE=redis@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Inject these through the deployment secret manager. Do not commit real values.
SVIX_POSTGRES_PASSWORD=REPLACE_AT_DEPLOYMENT
SVIX_JWT_SECRET=REPLACE_AT_DEPLOYMENT_WITH_AT_LEAST_32_RANDOM_BYTES
CODESTRA_PRIVATE_NETWORK=codestra-private
